# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for machine imports / scheduled refresh (long random string)
IMPORT_SECRET=change-me

# ---- MLS feed (RESO Web API / Spark / flexmls) ----
# Leave LISTINGS_PROVIDER unset to keep pasting CSV exports.
# LISTINGS_PROVIDER=csv | json | reso
# RESO_API_URL=https://replication.sparkapi.com/Version/3/Reso/OData
# RESO_API_TOKEN=
# Narrow this to your county. The default is active residential with no
# geography, which on a multi-county MLS pulls far more than you want and
# trips the row ceiling rather than importing a partial set.
# RESO_FILTER=StandardStatus eq 'Active' and PropertyType eq 'Residential' and CountyOrParish eq 'Fayette'
# GUESTY_API_KEY=

# Optional. A Google Cloud API key with the "Street View Static API" enabled.
# Unset, /api/streetview 404s and the map's hover card shows its no-photo note
# instead of an image — nothing breaks and nothing is billed. Set it and every
# candidate card gets a photo of the house from the road. Restrict the key to
# the Street View Static API; it is used server-side only and never reaches the
# browser, so an HTTP-referrer restriction would break it — use an API restriction.
GOOGLE_STREETVIEW_KEY=
